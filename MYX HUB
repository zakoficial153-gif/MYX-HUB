--========================================================--
-- MINIMIZAR
--========================================================--

local expandedSize = UDim2.fromOffset(280, 430)
local collapsedSize = UDim2.fromOffset(280, 50)

local collapsed = false

minimize.Activated:Connect(function()
	collapsed = not collapsed

	minimize.Text = collapsed and "+" or "-"

	if collapsed then
		content.Visible = false
	else
		content.Visible = true
	end

	TweenService:Create(
		menu,
		TweenInfo.new(
			0.3,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.InOut
		),
		{
			Size = collapsed and collapsedSize or expandedSize
		}
	):Play()
end)

--========================================================--
-- ANIMAÇÃO
--========================================================--

RunService.RenderStepped:Connect(function(dt)
	local speed = dt * 60

	outerGradient.Rotation =
		(outerGradient.Rotation + 0.9 * speed) % 360

	accentGradient.Rotation =
		(accentGradient.Rotation + 1.4 * speed) % 360

	titleGradient.Rotation =
		(titleGradient.Rotation + 1.2 * speed) % 360

	minimizeGradient.Rotation =
		(minimizeGradient.Rotation + 1.6 * speed) % 360

	for _, gradient in ipairs(animatedGradients) do
		gradient.Rotation =
			(gradient.Rotation + 1.8 * speed) % 360
	end
end)

