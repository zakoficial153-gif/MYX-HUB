--========================================================--

local function makeButton(name, text, y, height)
	local card = Instance.new("Frame")
	card.Name = name
	card.Size = UDim2.new(1, 0, 0, height)
	card.Position = UDim2.fromOffset(0, y)
	card.BackgroundColor3 = Color3.fromRGB(28, 22, 6)
	card.BackgroundTransparency = 0.05
	card.BorderSizePixel = 0
	card.Parent = content

	addCorner(card, 14)

	local cardGradient = addGradientStroke(card, 1.2)
	table.insert(animatedGradients, cardGradient)

	local button = Instance.new("TextButton")
	button.Name = "Button"
	button.Size = UDim2.new(1, -20, 1, -16)
	button.Position = UDim2.fromOffset(10, 8)
	button.BackgroundTransparency = 1
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = card

	local dot = Instance.new("Frame")
	dot.Size = UDim2.fromOffset(6, 6)
	dot.Position = UDim2.new(0, 0, 0.5, -3)
	dot.BackgroundColor3 = Color3.fromRGB(140, 100, 20)
	dot.BorderSizePixel = 0
	dot.Parent = button

	addCorner(dot, 3)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -20, 1, 0)
	label.Position = UDim2.fromOffset(14, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255, 250, 235)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = button

	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.fromOffset(20, 1)
	arrow.Position = UDim2.new(1, -22, 0, 0)
	arrow.BackgroundTransparency = 1
	arrow.Text = "›"
	arrow.TextColor3 = Color3.fromRGB(255, 200, 90)
	arrow.Font = Enum.Font.GothamBlack
	arrow.TextSize = 18
	arrow.Parent = button

	button.MouseEnter:Connect(function()
		TweenService:Create(
			card,
			TweenInfo.new(0.12),
			{
				BackgroundColor3 = Color3.fromRGB(50, 40, 9),
				BackgroundTransparency = 0
			}
		):Play()

		TweenService:Create(
			dot,
			TweenInfo.new(0.12),
			{
				BackgroundColor3 = Color3.fromRGB(255, 200, 60)
			}
		):Play()
	end)

	button.MouseLeave:Connect(function()
		TweenService:Create(
			card,
			TweenInfo.new(0.12),
			{
				BackgroundColor3 = Color3.fromRGB(28, 22, 6),
				BackgroundTransparency = 0.05
			}
		):Play()

		TweenService:Create(
			dot,
			TweenInfo.new(0.12),
			{
				BackgroundColor3 = Color3.fromRGB(140, 100, 20)
			}
		):Play()
	end)

	return card, button
end

